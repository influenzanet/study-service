JWT_TOKEN_KEY=local-lab-jwt-secret-change-me
STUDY_GLOBAL_SECRET=local-lab-study-secret

# Must match the dumped DB value
DB_NAME_PREFIX=

# If your mongo dump was taken from an auth-protected mongo, set these.
MONGO_USERNAME=
MONGO_PASSWORD=

# Leave unset to use stable production tags. Override to point at the
# locally-built refactor images. See Makefile targets.
# STUDY_IMAGE=influweb-local/study-service:refactor
# MGMT_IMAGE=influweb-local/management-api:refactor
# USERMGMT_IMAGE=influenzanet/user-management-image:v1.3.0-influenzanet

# Set these to the study/survey you want to export. Used by scripts/run-export.sh.
INSTANCE_ID=default
STUDY_KEY=
SURVEY_KEY=
# Date range filters in unix seconds. Leave empty for all-time.
FROM=
UNTIL=
# Column-naming controls (passed to the api-gateway query string).
# Leave empty to use the gateway defaults (sep="-", shortKeys="true").
# Set SEPARATOR=. and SHORT_KEYS=false to produce pandas-friendly columns
# like "intake.Q1.0" expected by dashboard/DataTreatment.py.
SEPARATOR=
SHORT_KEYS=
# Credentials of an admin/researcher account that exists in the imported DB.
ADMIN_EMAIL=
ADMIN_PASSWORD=
